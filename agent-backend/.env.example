# DeepSeek API 配置
# 到 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称，改成你实际可用的模型即可
# 官方常用: deepseek-chat（对话）、deepseek-reasoner（推理）
DEEPSEEK_MODEL=deepseek-chat

# 服务监听配置
APP_HOST=0.0.0.0
APP_PORT=8000

# 允许的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 同程预订频道。接入App后替换为客户端团队提供的Deep Link模板。
TONGCHENG_TRAIN_BOOKING_URL=https://www.ly.com/huochepiao/
TONGCHENG_FLIGHT_BOOKING_URL=https://www.ly.com/flights/home
TONGCHENG_HOTEL_BOOKING_URL=https://www.ly.com/hotel
TONGCHENG_TICKET_BOOKING_URL=https://www.ly.com/scenery/
